{
  "name": "max-telegram-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-runtime-assets.mjs && npm run build --workspace @maxbridge/web",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
